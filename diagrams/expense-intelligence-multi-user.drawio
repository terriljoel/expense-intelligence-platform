  <diagram id="multi-user-er" name="Current Multi-user ER">
    <mxGraphModel dx="2100" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Expense Intelligence Platform — PostgreSQL Multi-user ER&#xa;PK = primary key · FK = foreign key · UQ = unique · ? = nullable · dashed = view" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="55" as="geometry" /></mxCell>

        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; auth_subject : TEXT&lt;br&gt;&lt;b&gt;UQ ?&lt;/b&gt; email : TEXT&lt;br&gt;display_name : TEXT&lt;br&gt;created_at, updated_at : TIMESTAMPTZ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="210" as="geometry" /></mxCell>
