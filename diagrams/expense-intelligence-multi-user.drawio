        <mxCell id="households" value="&lt;b&gt;households&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; id : UUID&lt;br&gt;name : TEXT&lt;br&gt;default_currency : VARCHAR(3)&lt;br&gt;created_at, updated_at : TIMESTAMPTZ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="400" height="190" as="geometry" /></mxCell>
        <mxCell id="members" value="&lt;b&gt;household_members&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; household_id : UUID&lt;br&gt;&lt;b&gt;PK, FK&lt;/b&gt; user_id : UUID&lt;br&gt;role : owner | admin | member&lt;br&gt;is_active : BOOLEAN&lt;br&gt;joined_at : TIMESTAMPTZ&lt;br&gt;&lt;i&gt;Inactive rows preserve financial history&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1480" y="110" width="400" height="220" as="geometry" /></mxCell>

