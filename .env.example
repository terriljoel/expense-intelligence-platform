# Copy this file to .env for local development.
POSTGRES_DB=expense_intelligence
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=choose_a_local_password
DATABASE_URL=postgresql+psycopg://expense_app:choose_a_local_password@localhost:5432/expense_intelligence
AUTH_SESSION_HOURS=12
# Set true only when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
INVITATION_HOURS=168
# Private local receipt storage.
RECEIPT_IMAGE_DIR=data/receipt-images
RECEIPT_IMAGE_MAX_BYTES=10485760
# Use local for development or azure_blob for shared cloud storage.
RECEIPT_STORAGE_PROVIDER=local
AZURE_STORAGE_CONTAINER=receipt-images
# Local development option for azure_blob. Keep the real value only in .env.
AZURE_STORAGE_CONNECTION_STRING=
# Preferred with Managed Identity or `az login` instead of a connection string.
AZURE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
# Safe local default. Azure OCR can be enabled later with real secrets.
OCR_PROVIDER=tesseract
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_LOCALE=de-DE
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=60
# F0 limit is 4 MiB. The app compresses only the copy sent to Azure.
AZURE_DOCUMENT_INTELLIGENCE_MAX_BYTES=4194304
# Used only when OCR_PROVIDER=tesseract. Install the deu and eng language data.
TESSERACT_COMMAND=tesseract
TESSERACT_LANGUAGE=deu+eng
TESSERACT_TIMEOUT_SECONDS=45

# Product enrichment. Local aliases work without external providers or barcodes.
PRODUCT_ENRICHMENT_ENABLED=true
PRODUCT_ENRICHMENT_PROVIDERS=local,open_food_facts,search_a_licious
PRODUCT_AUTO_MATCH_THRESHOLD=0.92
PRODUCT_REVIEW_THRESHOLD=0.60
PRODUCT_FUZZY_MATCH_THRESHOLD=0.60
PRODUCT_MAX_LOCAL_CANDIDATES=5
PRODUCT_MAX_EXTERNAL_CANDIDATES=5
PRODUCT_PROVIDER_TIMEOUT_SECONDS=10
PRODUCT_MAX_PROVIDER_REQUESTS=3
PRODUCT_CACHE_HOURS=168
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
SEARCH_A_LICIOUS_BASE_URL=https://search.openfoodfacts.org
# Replace with an application URL or contact address before public use.
PRODUCT_PROVIDER_USER_AGENT=expense-intelligence/0.1 (personal project)
PRODUCT_AGENT_ENABLED=false
# Free, rate-limited GitHub Models API. Create a token with models:read permission.
# Keep this token only in .env locally or in the hosting platform's secret settings.
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_TOKEN=
PRODUCT_AGENT_TIMEOUT_SECONDS=30
# Optional merchant-aware web research. Tavily's key must remain secret.
PRODUCT_WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_MAX_RESULTS=5
